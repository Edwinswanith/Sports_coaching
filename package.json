{
  "name": "sports-coaching-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "mobile",
    "server"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:mobile": "npm run start --workspace mobile",
    "dev:mobile:after-api": "node scripts/wait-for-api.mjs && npm run dev:mobile",
    "predev": "node scripts/dev-clean.mjs",
    "dev": "npm-run-all --parallel dev:server dev:mobile:after-api",
    "typecheck:server": "npm run typecheck --workspace server",
    "typecheck:mobile": "npm run typecheck --workspace mobile",
    "typecheck": "npm-run-all typecheck:server typecheck:mobile",
    "test": "npm test --workspace server",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "build:server": "npm run build --workspace server",
    "build": "npm run build:server"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "npm-run-all": "^4.1.5"
  }
}
