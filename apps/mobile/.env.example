# Copy to .env for local dev. All EXPO_PUBLIC_* vars are inlined into the
# client bundle at build/start time (same rule as Next.js's NEXT_PUBLIC_*) —
# never put secrets here.

# Optional — overrides the API base URL. Defaults to http://localhost:4000 on
# web, or the deployed Cloud Run API on native (see src/lib/api.ts).
# EXPO_PUBLIC_API_BASE_URL=

# Optional — Google Sign-In web client ID. Defaults to the same client ID
# baked into GoogleSignInButton.tsx if unset.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional — comma-separated origins where the Google button should render.
# These must also be in Google Cloud Console -> OAuth client -> Authorized
# JavaScript origins. Leave unset for the deployed Cloud Run defaults.
# EXPO_PUBLIC_GOOGLE_ALLOWED_ORIGINS=

# Guided tour trigger: false (default) = once per new user, then stays
# dismissed. true = replays on every login (useful for testing/demos).
EXPO_PUBLIC_TOUR_ALWAYS_SHOW=false
