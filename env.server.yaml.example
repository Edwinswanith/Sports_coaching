# Cloud Run environment variables for the Apex API server (scp-server).
# ----------------------------------------------------------------------------
# Copy this file to env.server.yaml, fill in real values, then run deploy.bat.
# env.server.yaml is gitignored so secrets never get committed.
#
# Each value MUST be a quoted string. Do NOT set PORT here -- Cloud Run injects
# it and the server reads process.env.PORT automatically.
#
# IMPORTANT: when MONGODB_URI points at a remote / Atlas database, the server
# REFUSES to start with placeholder JWT secrets. Use long, unique, random
# strings (32+ chars) for both secrets. CORS_ORIGIN is set automatically by
# deploy.bat after the web service is deployed, so you can leave it out.

NODE_ENV: "production"
MONGODB_URI: "mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/sports?retryWrites=true&w=majority"
JWT_ACCESS_SECRET: "REPLACE_WITH_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"
JWT_REFRESH_SECRET: "REPLACE_WITH_DIFFERENT_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"
JWT_ACCESS_TTL: "15m"
JWT_REFRESH_TTL: "30d"

# "Sign in with Google" (existing accounts only). Leave empty to disable the
# feature. Must equal the web build's NEXT_PUBLIC_GOOGLE_CLIENT_ID. Create an
# OAuth 2.0 Web client in Google Cloud Console -> Credentials, and add the
# deployed web URL to its "Authorized JavaScript origins".
GOOGLE_CLIENT_ID: ""

# Gemini — workout-image OCR, athlete voice-intent NLU, guided-tour narration.
# Leave empty to fall back to deterministic mocks. Create a key at Google AI
# Studio (aistudio.google.com/app/apikey). GEMINI_MODEL is optional.
GEMINI_API_KEY: ""
# GEMINI_MODEL: "gemini-2.5-flash-lite"

# Deepgram — Ask Agent speech-to-text and text-to-speech. Keep this server-side;
# never bake it into the mobile app.
DEEP_GRAM: ""
# DEEPGRAM_STT_MODEL: "flux-general-multi"
# DEEPGRAM_TTS_MODEL: "aura-2-harmonia-en"
# DEEPGRAM_STREAM_ENDPOINTING_MS: "400"
# DEEPGRAM_STREAM_UTTERANCE_END_MS: "1000"
