# Copy to .env at the repo root, or place specific values in apps/web/.env.local
# and server/.env.

# ----- Server -----
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://edwinswanith006_db:Edwin006@athletes.onwotwy.mongodb.net/?appName=athletes
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,https://scp-web-futtj2vwgq-el.a.run.app

# Optional — coach media uploads. Defaults: ./uploads (relative to the server
# process cwd) and 8 MB per file.
# UPLOAD_DIR=uploads
# MAX_UPLOAD_SIZE_MB=8

# Optional — Gemini vision, used to extract a structured workout table from a
# coach's uploaded image. Without a key, a placeholder mock table is returned.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

# Optional — mobile Ask Agent speech-to-text and text-to-speech.
# DEEP_GRAM=
# DEEPGRAM_STT_MODEL=flux-general-multi
# DEEPGRAM_TTS_MODEL=aura-2-harmonia-en
# DEEPGRAM_STREAM_ENDPOINTING_MS=400
# DEEPGRAM_STREAM_UTTERANCE_END_MS=1000

# Production must override MONGODB_URI, JWT_ACCESS_SECRET, and
# JWT_REFRESH_SECRET. Placeholder JWT secrets are rejected when NODE_ENV=production.

# ----- Web -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Optional — local voice-demo assistant. GOOGLE_API_KEY powers Gemini command
# interpretation; DEEP_GRAM powers browser microphone transcription through the
# server-side /voice-demo/api/transcribe route.
# GOOGLE_API_KEY=
# DEEP_GRAM=
