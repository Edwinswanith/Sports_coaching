# Copy to .env at the repo root, or place server-specific values in server/.env.

# ----- Server -----
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://edwinswanith006_db:Edwin006@athletes.onwotwy.mongodb.net/?appName=athletes
MONGODB_DB=sports_coaching
AUTH_SECRET=replace_with_one_strong_secret_for_vercel
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# Optional — coach media uploads. Defaults: ./uploads (relative to the server
# process cwd) and 8 MB per file.
# UPLOAD_DIR=uploads
# MAX_UPLOAD_SIZE_MB=8

# Optional — Apple Sign In token audience. Native iOS tokens use the bundle ID.
# APPLE_CLIENT_ID=app.apex.coaching

# Optional — Gemini vision, athlete voice-intent NLU, and guided-tour narration.
# Without a key, deterministic mocks/placeholders are used.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional — mobile Ask Agent speech-to-text and text-to-speech.
# DEEP_GRAM=
# DEEPGRAM_STT_MODEL=flux-general-multi
# DEEPGRAM_TTS_MODEL=aura-2-harmonia-en
# DEEPGRAM_STREAM_ENDPOINTING_MS=400
# DEEPGRAM_STREAM_UTTERANCE_END_MS=1000

# Production must override MONGODB_URI and AUTH_SECRET, or both JWT_ACCESS_SECRET
# and JWT_REFRESH_SECRET. Placeholder JWT secrets are rejected when NODE_ENV=production.

# ----- Web (Vercel) -----
# The static Expo web build intentionally leaves EXPO_PUBLIC_API_URL empty.
# Production web uses window.location.origin and calls the same-origin /api/* routes.

# ----- Mobile (Expo) -----
# Native iOS/Android production builds must point at the deployed Vercel URL.
# EXPO_PUBLIC_API_URL=https://your-vercel-domain.vercel.app
