# Copy to .env at the repo root, or place specific values in apps/web/.env.local
# and server/.env.

# ----- Server -----
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://edwinswanith006_db:Edwin006@athletes.onwotwy.mongodb.net/?appName=athletes
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# Optional — coach media uploads. Defaults: ./uploads (relative to the server
# process cwd) and 8 MB per file.
# UPLOAD_DIR=uploads
# MAX_UPLOAD_SIZE_MB=8

# Optional — Gemini vision, used to extract a structured workout table from a
# coach's uploaded image. Without a key, a placeholder mock table is returned.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Production must override MONGODB_URI, JWT_ACCESS_SECRET, and
# JWT_REFRESH_SECRET. Placeholder JWT secrets are rejected when NODE_ENV=production.

# ----- Web -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
