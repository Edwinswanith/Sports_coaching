# Cloud Run runtime environment variables for the Apex web frontend (scp-web).
# ----------------------------------------------------------------------------
# Copy this file to env.web.yaml, fill in real values, then run deploy.bat.
# env.web.yaml is gitignored so secrets never get committed.
#
# These are SERVER-SIDE Next.js vars (read by /voice-demo API routes at runtime).
# Do NOT prefix with NEXT_PUBLIC_. They are NOT baked into the client bundle.
#
# Leave a key empty to disable that feature; deploy.bat still succeeds.

# Gemini — powers /voice-demo command interpretation and response humanization.
# Create a key at Google AI Studio (aistudio.google.com/app/apikey).
GOOGLE_API_KEY: ""

# Deepgram — powers /voice-demo/api/transcribe (browser microphone push-to-talk).
# Create a key at console.deepgram.com.
DEEP_GRAM: ""

# Optional model override for the voice-demo Gemini calls (default: gemini-2.5-flash).
# GEMINI_MODEL: "gemini-2.5-flash"
